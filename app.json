{
  "expo": {
    "name": "Bout",
    "slug": "bout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bout",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
